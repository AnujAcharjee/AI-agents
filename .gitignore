# Python virtual environments
venv/
.venv/
env/
.env/

# Ignore venv directories at any depth
**/venv/
**/.venv/
**/env/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Python build / packaging
build/
dist/
*.egg-info/
**/*.egg-info/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checkers
.mypy_cache/
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example

# IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

